/* This file is an example of environment variables `.env` which is hidden using .gitignore.
 * It is used to store sensitive information such as API keys and configuration settings.
 * Copy this example file to `.env` and fill in your own values.
 * Make sure `.env` is always in `.gitignore` file and never exposed in public repositories.
 * The variables defined here can be accessed in the application using process.env.VARIABLE_NAME.
 */

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project-region.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id